# Projectplaner local environment
#
# The app and `pnpm plan` both read the nearest `.env` found from the current
# working directory upward. Copy this file to `.env` and comment paths in/out.

# Use the repo-root SQLite database shared by the Next app and CLI.
PROJECTPLANER_DB_PATH=".\projectplaner.db"
WEB_SEARCH_ENDPOINT="http://localhost:8080"
# Optional CortexDB knowledge service used by the read-only knowledge_search workflow node.
# PROJECTPLANER_KNOWLEDGE_URL="http://127.0.0.1:5000"
# PROJECTPLANER_KNOWLEDGE_DATASET="project-plan"
# PROJECTPLANER_CORTEXDB_ROOT="..\CortexDB"
# PROJECTPLANER_CORTEXDB_PYTHON="C:\Program Files\Python312\python.exe"

# PostgreSQL/pgvector development service. The same instance can host the
# Projectplaner and CortexDB schemas without sharing their write models.
# When these URLs are set, Projectplaner uses Postgres for its relational data
# and CortexDB can use its Postgres/pgvector store.
# POSTGRES_DB="projectplaner"
# POSTGRES_USER="projectplaner"
# POSTGRES_PASSWORD="projectplaner-dev"
# POSTGRES_PORT="5432"
# PROJECTPLANER_DATABASE_URL="postgresql://projectplaner:projectplaner-dev@127.0.0.1:5432/projectplaner"
# CORTEXDB_DATABASE_URL="postgresql://projectplaner:projectplaner-dev@127.0.0.1:5432/projectplaner"

# Example: use a scratch database while testing migrations.
# PROJECTPLANER_DB_PATH=".\projectplaner.scratch.db"
# PROJECTPLANER_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PROJECTPLANER_LLM_MODEL=llama3:latest
# Optional: PROJECTPLANER_LLM_API_KEY=...
# Generate / author_workflow use two LLM turns (outline text → graph JSON).
# Demo: pnpm plan author-demo --brief "..."
# Live create_workflow: pnpm plan create-workflow-demo --brief "Halve currentValue, then triple it."
# Live checks: pnpm test:llm
PROJECTPLANER_PRINCIPAL_ID="local-user"
