# Projectplaner local environment
#
# The app and `pnpm plan` both read the nearest `.env` found from the current
# working directory upward. Copy this file to `.env` and comment paths in/out.

# Use the repo-root SQLite database shared by the Next app and CLI.
PROJECTPLANER_DB_PATH=".\projectplaner.db"

# Example: use a scratch database while testing migrations.
# PROJECTPLANER_DB_PATH=".\projectplaner.scratch.db"
# PROJECTPLANER_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PROJECTPLANER_LLM_MODEL=llama3:latest
# Optional: PROJECTPLANER_LLM_API_KEY=...
# Generate / author_workflow use two LLM turns (outline text → graph JSON).
# Demo: pnpm plan author-demo --brief "..."
# Live checks: pnpm test:llm
