{
  "name": "@projectplaner/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/repositories/entities.ts",
    "./relations": "./src/repositories/relations.ts",
    "./projects": "./src/repositories/projects.ts",
    "./snapshots": "./src/repositories/snapshots.ts",
    "./tasks": "./src/repositories/tasks.ts",
    "./query": "./src/query/index.ts",
    "./workflows": "./src/workflows/index.ts",
    "./llm-json-schemas": "./src/repositories/llm-json-schemas.ts",
    "./assistant-sessions": "./src/repositories/assistant-sessions.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "plan": "tsx src/agent-cli.ts",
    "test:node": "tsx --test src/query.node-test.ts src/presets.node-test.ts src/workflows.node-test.ts src/rollup.node-test.ts src/projects.node-test.ts src/api.node-test.ts src/example-signal-desk.node-test.ts src/llm-json-schemas.node-test.ts src/assistant-sessions.node-test.ts"
  },
  "dependencies": {
    "@projectplaner/core": "workspace:*"
  }
}
