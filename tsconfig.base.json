{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@projectplaner/core": ["packages/core/src/index.ts"],
      "@projectplaner/db": ["packages/db/src/index.ts"],
      "@projectplaner/mcp": ["packages/mcp/src/index.ts"],
      "@projectplaner/agent": ["apps/agent/src/index.ts"]
    }
  }
}

