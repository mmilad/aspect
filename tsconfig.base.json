{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@projectplaner/workspace": [
        "packages/workspace/src/index.ts"
      ],
      "@projectplaner/core": [
        "packages/core/src/index.ts"
      ],
      "@projectplaner/core/query": [
        "packages/core/src/domain/query/index.ts"
      ],
      "@projectplaner/core/plan-api": [
        "packages/core/src/domain/api/index.ts"
      ],
      "@projectplaner/core/domain": [
        "packages/core/src/domain/index.ts"
      ],
      "@projectplaner/core/legacy": [
        "packages/core/src/legacy/index.ts"
      ],
      "@projectplaner/core/workflow": [
        "packages/core/src/workflow/index.ts"
      ],
      "@projectplaner/core/planning": [
        "packages/core/src/planning/index.ts"
      ],
      "@projectplaner/core/generator": [
        "packages/core/src/generator/index.ts"
      ],
      "@projectplaner/core/assistant": [
        "packages/core/src/assistant/index.ts"
      ],
      "@projectplaner/db": [
        "packages/db/src/index.ts"
      ],
      "@projectplaner/mcp": [
        "packages/mcp/src/index.ts"
      ],
      "@projectplaner/agent": [
        "apps/agent/src/index.ts"
      ]
    }
  }
}
